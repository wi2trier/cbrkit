# Python bindings of the OMG BPMN 2.0 XML schemas, generated by xsdata.
# The OMG terms forbid shipping the schemas, so only the bindings are vendored.
# To update, bump `version`, replace the hashes with `lib.fakeHash`,
# and copy the correct ones from the errors of `nix build .#bpmn-bindings`.
{
  lib,
  stdenvNoCC,
  fetchurl,
  python3,
  writeShellApplication,
  coreutils,
  git,
}:
let
  version = "20100501";
  schemas = {
    BPMN20 = "sha256-oHwVnLBZRXPdfJexNw3RFhEjePN35DyJqL9RKsUDBwU=";
    Semantic = "sha256-xDGIQvfSu8Ji15VMlFLFAdsW8IaOrAuHMuxdf7OE2ac=";
    BPMNDI = "sha256-8N/xzVWdFRTY6/yMZG9YQCvKztJ+wi4qpkVsLcyAsDg=";
    DC = "sha256-ovkOWtm7SMaRXk4DS04nrIOCZKHU8nv8cNvfxpNRMS0=";
    DI = "sha256-giCxecF1Vy33TgilG/+r6VeGeWIDXO57X+4LastMRJg=";
  };
  fetchSchema =
    name: hash:
    fetchurl {
      url = "https://www.omg.org/spec/BPMN/${version}/${name}.xsd";
      inherit hash;
    };
  xsdata = python3.withPackages (ps: [ ps.xsdata ] ++ ps.xsdata.optional-dependencies.cli);
  header = ''
    """Bindings of the OMG BPMN 2.0.2 schemas, generated by xsdata.

    The schemas are published at https://www.omg.org/spec/BPMN/2.0.2.
    Do not edit by hand, regenerate them with `nix run .#vendor-bpmn` instead.
    """
  '';
  bindings = stdenvNoCC.mkDerivation {
    pname = "bpmn-bindings";
    inherit version;
    dontUnpack = true;
    nativeBuildInputs = [ xsdata ];
    buildPhase = ''
      runHook preBuild

      mkdir schemas
      ${lib.concatLines (
        lib.mapAttrsToList (name: hash: "cp ${fetchSchema name hash} schemas/${name}.xsd") schemas
      )}
      xsdata generate --config ${./xsdata.xml} schemas/BPMN20.xsd

      runHook postBuild
    '';
    installPhase = ''
      runHook preInstall

      mkdir $out

      for file in bpmn/*.py; do
        { printf '%s\n' ${lib.escapeShellArg header}; cat "$file"; } > "$out/$(basename "$file")"
      done

      runHook postInstall
    '';
    passthru.vendor = writeShellApplication {
      name = "vendor-bpmn";
      runtimeInputs = [
        coreutils
        git
      ];
      text = ''
        target="$(git rev-parse --show-toplevel)/src/cbrkit/model/graph/_bpmn_schema"
        rm -rf "$target"
        cp -r --no-preserve=mode ${bindings} "$target"
        git add "$target"
      '';
    };
  };
in
bindings
